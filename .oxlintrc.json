{
  "plugins": ["typescript", "vue", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "no-underscore-dangle": ["warn", { "allow": ["_data"] }]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".nuxt",
    ".output",
    "dist",
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}
