{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "wrangler:dev": "bun run build && bunx wrangler dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test:nuxt": "vitest --project nuxt",
    "test:server": "vitest --project server --run",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "deploy:staging": "wrangler deploy -e staging",
    "deploy": "wrangler deploy -e production --minify",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nuxt/scripts": "1.3.8",
    "@nuxt/test-utils": "^4.2.0",
    "@prettier/plugin-oxc": "^0.2.2",
    "@unhead/vue": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.42",
    "nuxt": "^4.5.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-nuxt": "2.8.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  }
}
